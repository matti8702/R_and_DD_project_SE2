@startuml RV29_diagram
hide footbox

participant "Internship Proposal Manager" as IM
participant "Data Manager" as DM
participant "DBMS" as DB
participant "Recommendation manager" as RM
participant "External statistical tool" as ESAT

activate IM
IM -> DM   : closeInternship(internshipID)
activate DM
DM -> DB   : executeStatement(statement)
activate DB
DB --> DM  : ok
deactivate DB
DM --> IM  : ok
deactivate DM
IM -> RM   : deleteInternship(internshipId)
activate RM
RM -> ESAT   : removeEntity(ENTITYTYPE.INTERNSHIP, internshipId)
activate ESAT
ESAT --> RM : ok
deactivate ESAT
RM --> IM  : ok
deactivate RM
@enduml