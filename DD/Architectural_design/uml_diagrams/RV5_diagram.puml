@startuml RV5_diagram
hide footbox

participant "Student" as S
participant "Web App" as W
participant "Controller" as C
participant "Login Manager" as L
participant "Recommendation Manager" as RE
participant "Data Manager" as DM
participant "Relational DBMS" as RD
participant "External statistical tool" AS EXT

activate S
activate W
activate C
S -> W: click "Login" button
W --> S: show login form
S -> W: insert data
W -> C: login(emailAddress, password)
C -> L: login(emailAddress, password)
activate L
L -> DM: getUserPassword(emailAddress)
activate DM
DM -> RD: executeStatement(statement)
activate RD
RD --> DM: password
deactivate RD
DM --> L: password
deactivate DM
L -> L: checkCredentials(userInput, userCredentials)

alt credentials are valid
    L -> L: generateToken()
    L -> DM: addToken(userEmail, token)
    activate DM
    DM -> RD: executeStatement(statement)
    activate RD
    RD --> DM: ok
    deactivate RD
    DM --> L: ok
    deactivate DM

    L -> DM: getStudentID(userEmail)
    activate DM
    DM -> RD: executeStatement(statement)
    activate RD
    RD --> DM: student ID
    deactivate RD
    DM --> L: student ID
    deactivate DM

    L -> RE: getStudentRecommendations(studentID)
    activate RE
    RE -> EXT: findStudentRecommendations(studentID)
    activate EXT
    EXT --> RE: recommendations
    deactivate EXT
    RE -> DM: updateRecommendations(studentID, recommendations)
    activate DM
    DM -> RD: executeStatement(statement)
    activate RD
    RD --> DM: ok
    deactivate RD
    DM --> RE: ok
    deactivate DM
    RE --> L: recommendations
    deactivate RE
    L --> C: user token, recommendations
    C --> W: user token, recommendations
    W -> W: store token
    W --> S: show the homepage with recommendations
else invalid credentials
    L --> C: ko
    C --> W: ko
    W --> S: show error message "Invalid credentials"
end

@enduml

