@startuml UC15_diagram
hide footbox

participant "Company Member" as CM
participant "S&C" AS S
participant "Student" as ST

activate CM
activate S
CM -> S: selectStudent(student)
S --> CM: student info
CM -> S: sendRequest(request, student)
S -> S:  checkNumberRequest()
alt First time the request is sent
    S -> S: retrieveCompanyMemberInfo()
    S ->> ST : sendRequest(request, companyMember)
    activate ST
    deactivate ST
    S --> CM : new list of candidates 
else else
    S --> CM: error message
end
@enduml