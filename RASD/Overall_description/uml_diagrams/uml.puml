@startuml uml 

together{
    abstract class User{
        + email: String
        + password: String
    }

    class Student extends User{
        + name: String
        + surname: String
        + dateOfBirthday: Date
    }
    Student "0..*" --* "1" University : enrolled
    note top of Student: Email attribute for Student stands for institutional email

    class CompanyMember extends User{

    }
    CompanyMember "1..*" --* "1" Company : employ

    class UniversityMember extends User{

    }
    UniversityMember "1..*" --* "1" University : employ

    class University{
        + universityName: String 
    }

    class Company{
        + companyName: String
    }
}

class CurriculumVitae{

}
CurriculumVitae "1" --* "1" Student : owns

class Internship{
    + name: String
    + dateOfPublication: Date
    + applicationStartDate: Date
    + applicationEndDate : Date
}
Company "1" -- "0..*" Internship : offer

class InternshipDescription{
    + description: String
    + requirements: String
    + applicationDomain: String
    + terms: String
}
InternshipDescription "1" --* "1" Internship : owns

class InternshipStatus{
    + interruptionRequested: Boolean
}
InternshipStatus "0..*" -- "1" Student : partecipate
InternshipStatus "0..*" -- "1" Internship : manage
InternshipStatus "1*" *-- "0..*" InternshipComplaint : has

note top of InternshipStatus: Universities access to the intership manager through the students

class InternshipComplaint{
    + description: String
    + dateOfCreation: Date
    + title: String
}

class InternshipReport{
    + dateOfCreation: Date
    + title: String
    + description: String
}
InternshipReport "0..*" -- "1" InternshipStatus : has
InternshipReport "0..*" -- "1" User : owner

class Chat{

}

class Message{
    + content: String
    + timestamp: Timestamp
}

User "1" -- "0..*"  Message : sender

Message "0..*" --* "1" Chat : contain
Student "1" -- "0..*"  Chat : have
CompanyMember "1" -- "0..*"  Chat : have


class Request{
    + approved: Boolean 
    + dateOfCreation: Date
}
Request "0..*" -- "1" Internship : refer
Request "0..*" -- "1" User : requestedBy
note top of Request: it represents a generic matching proposal made by either company or student

class StudentSelectionProcess{
    + selected: Boolean
}
note top of StudentSelectionProcess: selected means "student of this selection process has been selected for the internship"

StudentSelectionProcess "0..*" -- "1" Student : partecipate
StudentSelectionProcess "0..*" -- "1" Internship : refer
StudentSelectionProcess "1" -- "1" Chat : have
StudentSelectionProcess "1" -- "1" Interview : have

abstract class Interview{
    + date: Date
    + details: String
    + estimatedDuration: String
}

class OnlineInterview extends Interview{
    + link: String
}

note top of OnlineInterview: Link is provided by an external video conference tool

class InPersonInterview extends Interview{
    + address: String
    + room: String
}

class Feedback {
    + globalScore: Float
    + comment: String
}

Feedback "0..*" -- "1" Internship : have
Feedback "0..*" -- "1" User : creator

class FieldEvaluation{
    + fieldName: String
    + description:String
    + score: Float
}
FieldEvaluation "0..*" -- "1" Feedback : have

class Suggestion{

}
note top of Suggestion: it represents either CVs suggestions or internship's description suggestion

class Recommendation{
    compatibilityRate: Float
}
Recommendation "0..*" -- "1" Internship : recommendedInternship
Recommendation "0..*" -- "1" Student : recommendedStudent

@enduml

