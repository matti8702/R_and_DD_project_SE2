@startuml UC11_diagram
hide footbox

participant "Student" as ST
participant "Company member" as CM
participant "External statistical tool" AS EXT
participant "eMail provider" as EP
participant "S&C" AS S

activate ST
activate CM
activate S
S -> EXT: updateStatistics(currentState, newData)
activate EXT
EXT -> EXT: computeNewStatistics()
EXT --> S: updated statistics
deactivate EXT
S -> S: findRecommendations()
S -> EP: sendEmailRequest(studentEmailAddress, text)
activate EP
EP --> S: ok
EP -> ST: sendEmail(email)
deactivate EP
S -> EP: sendEmailRequest(companyMemberEmailAddress, text)
activate EP
EP --> S: ok
EP -> CM: sendEmail(email)
deactivate EP
@enduml